{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaaw3d.dev/schemas/correction-ticket.schema.json",
  "title": "yaaw-3D Correction Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["iteration", "owner", "findings", "required_changes", "acceptance_checks", "artifact_id"],
  "properties": {
    "iteration": {"type": "integer", "minimum": 1},
    "owner": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "required_changes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "items": {"type": "string"}}
  }
}
