{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaaw3d.dev/schemas/correction-ticket.schema.json",
  "title": "yaaw-3D Correction Ticket",
  "type": "object",
  "required": ["iteration", "owner", "findings", "required_changes", "acceptance_checks"],
  "properties": {
    "iteration": {"type": "integer", "minimum": 1},
    "owner": {"type": "string"},
    "findings": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_changes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
